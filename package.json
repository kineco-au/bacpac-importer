{
  "name": "@kineco-au/bacpac-importer",
  "version": "1.0.0",
  "description": "Convert a SQL Server .bacpac to SQLite, Postgres or MySQL. Reads the export directly, tables and data, with no SQL Server, SqlPackage or .NET.",
  "keywords": [
    "bacpac",
    "dacpac",
    "sql-server",
    "mssql",
    "azure-sql",
    "sqlite",
    "postgres",
    "postgresql",
    "mysql",
    "mariadb",
    "database",
    "migration",
    "converter",
    "bun"
  ],
  "license": "MIT",
  "author": "Kineco",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kineco-au/bacpac-importer.git"
  },
  "homepage": "https://github.com/kineco-au/bacpac-importer#readme",
  "bugs": {
    "url": "https://github.com/kineco-au/bacpac-importer/issues"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "bacpac-importer": "./src/cli.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "biome check . && tsc --noEmit",
    "fix": "biome check --write .",
    "test": "bun test tests/unit",
    "test:integration": "bun test ./tests/integration/*.integration.ts --timeout 300000",
    "test:all": "bun run test && bun run test:integration"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
